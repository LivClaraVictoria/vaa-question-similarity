+    @staticmethod
+    def _jaccard_curve(list_a: list, list_b: list, kmax: int) -> np.ndarray:
+        """Jaccard of the top-k sets for k = 1..kmax in one pass (entries beyond a list's end are NaN)."""
+        out = np.full(kmax, np.nan)
+        seen_a, seen_b, inter = set(), set(), 0
+        for i in range(min(kmax, len(list_a), len(list_b))):
+            a, b = list_a[i], list_b[i]
+            inter += a in seen_b
+            seen_a.add(a)
+            inter += b in seen_a
+            seen_b.add(b)
+            out[i] = inter / (2 * (i + 1) - inter)
+        return out
+
+    def _jaccard_at_ks(self, std_a, std_b, crw_a, crw_b) -> dict:
+        """{base,crw}_jaccard_k{k} for every k in self.k_grid (empty dict if no grid was set)."""
+        grid = getattr(self, "k_grid", None)
+        if not grid:
+            return {}
+        kmax = max(grid)
+        base = self._jaccard_curve(std_a, std_b, kmax)
+        crw = self._jaccard_curve(crw_a, crw_b, kmax)
+        cols = {}
+        for k in grid:
+            cols[f"base_jaccard_k{k}"] = base[k - 1]
+            cols[f"crw_jaccard_k{k}"] = crw[k - 1]
+        return cols
+
